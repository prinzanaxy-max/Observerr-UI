# Copy this file to .env and adjust values as needed
VITE_PORT=5173

# Primary API URL (used in production)
VITE_API_URL=https://observerr-production.up.railway.app

# Local development fallback
# VITE_API_URL=http://localhost:8080

# Legacy alias — still supported if VITE_API_URL is unset
VITE_API_BASE_URL=http://localhost:8080

# Public LiveKit websocket URL. Tokens are always fetched from the backend.
# Leave unset to keep exams usable with the review-required offline fallback.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Native Web Push (VAPID) — must match backend VAPID_PUBLIC_KEY
# Generate: npx web-push generate-vapid-keys
# Production builds also read .env.production (committed public key only).
# Set the same public key in Cloudflare Pages → Environment variables if you override builds.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
