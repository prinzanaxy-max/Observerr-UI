# Copy this file to .env and adjust values as needed
VITE_PORT=5173

# Primary API URL (used in production)
VITE_API_URL=https://observerr-production.up.railway.app

# Local development fallback
# VITE_API_URL=http://localhost:8080

# Legacy alias — still supported if VITE_API_URL is unset
VITE_API_BASE_URL=http://localhost:8080

# Firebase (web push / FCM) — get values from Firebase Console → Project settings
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Cloud Messaging VAPID key (Project settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key
